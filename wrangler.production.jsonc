{
  "name": "xstream",
  "account_id": "947309b8559eadac8c20a351beedf8c6",
  "main": "apps/worker/src/production.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "zemi.gg", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS", "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": { "APP_ORIGIN": "https://zemi.gg" },
  "ratelimits": [{ "name": "PIN_ATTEMPTS", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }, { "name": "PAIRING_STARTS", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "xstream",
    "database_id": "f4b8cbc2-cd0f-465a-804c-6f851e787749",
    "migrations_dir": "apps/worker/migrations"
  }]
}
